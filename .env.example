# crypto_system configuration template — copy to .env and fill in.
# NEVER commit .env. Secrets never enter git, logs, reports, or ledgers.

# --- mode -------------------------------------------------------------------
# paper (default, automatic) | live (disabled by default; every live order
# additionally requires human approval of an immutable, expiring request).
CS_MODE=paper
# Must be true for live mode, and live mode is OFF by default:
CS_LIVE_ENABLED=false

# --- state isolation --------------------------------------------------------
# Paper and live ledgers/state NEVER share a write path. Defaults:
# CS_PAPER_STATE_DIR=data/cs_state/paper
# CS_LIVE_STATE_DIR=data/cs_state/live

# --- execution --------------------------------------------------------------
# CS_EXCHANGE=binance-usdm
# CS_INITIAL_CASH=10000
# CS_MAKER_FEE=0.0002
# CS_TAKER_FEE=0.0005
# CS_FUNDING_INTERVAL_HOURS=8

# --- reporting --------------------------------------------------------------
# Telegram is report-only; it can never place, modify, or approve orders.
# CS_TELEGRAM_REPORT_ENABLED=true
# CS_TELEGRAM_BOT_TOKEN=
# CS_TELEGRAM_CHAT_ID=

# --- live transport (only if you fully understand the risk) -----------------
# Keys MUST be trading-only: withdraw/transfer permissions are prohibited.
# Keys for the Binance USDⓈ-M TESTNET first; production keys only after a
# human operator has approved each order in the approval queue.
# CS_BINANCE_API_KEY=
# CS_BINANCE_API_SECRET=
