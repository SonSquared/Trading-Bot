# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.eggs/

# Data
data/raw/
data/processed/
# Exclude the RESULTS DIRECTORY's CONTENTS (not the directory itself — git
# cannot re-include a file inside an excluded directory, so the negation
# below would silently not work with a plain "data/results/" rule).
data/results/*
data/reports/
data/charts/
data/bot_state.json
data/bot.log
# EXCEPT the deployed portfolio: the Actions runner must trade exactly what
# the walk-forward league promoted. Gitignored = every cloud run silently
# falls back to the stale hardcoded defaults (the pre-tournament BB_RSI set).
!data/results/bot_strategy_params.json
*.db
*.parquet

# Environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# OS
.DS_Store
Thumbs.db

# Secrets / Config with credentials
configs/bot_live.yaml
data/models/*.pkl
data/bot_state.json
.freebuff/
run_logs.zip
